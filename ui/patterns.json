{
  "version": "0.4",
  "selection_rule": "learner action -> observed operation/modality -> accessible capability -> justified variety; load only selected pattern spec",
  "patterns": [
    {
      "type": "cloze",
      "goal": "retrieve form from context",
      "input": "text field",
      "assessment": "accepted variants plus context; no answer before attempt",
      "spec_ref": "ui/patterns/recognition.md"
    },
    {
      "type": "sentence_builder",
      "goal": "compose grammatical chunks",
      "input": "ordering or controlled text",
      "assessment": "accuracy plus independent retry in different context",
      "spec_ref": "ui/patterns/construction.md"
    },
    {
      "type": "image_label",
      "goal": "retrieve English word or phrase after seeing a real picture",
      "input": "real image with native text input directly beneath and accessible text fallback",
      "assessment": "case-insensitive expected word plus accepted aliases can be locally checked; written image-prompted recall only",
      "spec_ref": "ui/patterns/recognition.md"
    },
    {
      "type": "grammar_contrast",
      "goal": "discriminate intended meaning",
      "input": "options plus short justification",
      "assessment": "choice and reason",
      "spec_ref": "ui/patterns/recognition.md"
    },
    {
      "type": "error_detective",
      "goal": "notice and repair a specific error",
      "input": "text correction",
      "assessment": "corrected meaning and new independent example",
      "spec_ref": "ui/patterns/construction.md"
    },
    {
      "type": "vocabulary_retrieval",
      "goal": "retrieve useful chunks",
      "input": "open text field",
      "assessment": "meaning and context, not exact token matching alone",
      "spec_ref": "ui/patterns/recognition.md"
    },
    {
      "type": "free_production",
      "goal": "demonstrate independent communication",
      "input": "text box or accessible speech tool",
      "assessment": "can-do rubric; modality labelled",
      "spec_ref": "ui/patterns/construction.md"
    },
    {
      "type": "dialogue",
      "goal": "sustain conversational interaction",
      "input": "chat turns",
      "assessment": "coherence, response appropriateness, clarification",
      "spec_ref": "ui/patterns/media-interaction.md"
    },
    {
      "type": "listening",
      "goal": "understand actual audio",
      "input": "source audio plus questions",
      "assessment": "gist and detail; never simulate an unheard recording",
      "spec_ref": "ui/patterns/media-interaction.md"
    },
    {
      "type": "scenario",
      "goal": "make decisions and justify",
      "input": "options and free explanation",
      "assessment": "plausible trade-offs and linguistic accuracy",
      "spec_ref": "ui/patterns/recognition.md"
    },
    {
      "type": "progress_explorer",
      "goal": "explain evidenced learning state",
      "input": "view plus optional filters",
      "assessment": "not an assessment; read-only summary",
      "spec_ref": "ui/patterns/media-interaction.md"
    },
    {
      "type": "matching",
      "goal": "associate words, meanings or situations",
      "input": "select/text pairs",
      "assessment": "recognition only",
      "spec_ref": "ui/patterns/recognition.md"
    },
    {
      "type": "card_ordering",
      "goal": "construct a sequence or sentence order",
      "input": "native reorder or numbered/text fallback",
      "assessment": "guided construction",
      "spec_ref": "ui/patterns/construction.md"
    },
    {
      "type": "image_choice",
      "goal": "identify an item in a real image",
      "input": "relevant image plus accessible labeled choices",
      "assessment": "visual recognition not listening",
      "spec_ref": "ui/patterns/recognition.md"
    },
    {
      "type": "spoken_response",
      "goal": "genuine spoken production",
      "input": "accessible learner audio only",
      "assessment": "observed audio only",
      "spec_ref": "ui/patterns/media-interaction.md"
    }
  ],
  "feedback": {
    "scope": "provisional UI only",
    "timing": "on input change after first response",
    "eligible": [
      "single-choice",
      "fixed grammar choice",
      "finite image label",
      "completed card ordering"
    ],
    "deferred": [
      "open writing",
      "ambiguous alternatives"
    ],
    "statuses": [
      "unanswered",
      "correct",
      "try_again",
      "deferred"
    ],
    "submit_count": 1,
    "client_metadata": [
      "first_response",
      "revision_count",
      "hint_level"
    ]
  },
  "underlined_explanation": {
    "ui": "inline popover",
    "parallel_chat_available_to_author": false
  }
}
