{
  "schema_version": 2,
  "description": "Empty schema blueprint for user-owned Google Sheets. The agent creates tabs only after consent; no learner values are preseeded.",
  "workbook_name": "ASIT — Learner State",
  "tabs": [
    {
      "name": "Config",
      "columns": [
        "key",
        "json_value",
        "updated_at_utc"
      ],
      "notes": "schema_version, user preferences, storage consent and learner-owned identifiers; no source-level defaults"
    },
    {
      "name": "Goals",
      "columns": [
        "goal_id",
        "description",
        "priority",
        "status",
        "created_at_utc",
        "reason"
      ],
      "notes": "learner-provided or agent-proposed goals must be approved"
    },
    {
      "name": "Competencies",
      "columns": [
        "competency_id",
        "can_do",
        "cefr_reference",
        "dependency_ids_json",
        "priority",
        "status",
        "evidence_count",
        "confidence_label",
        "last_observed_at_utc"
      ],
      "notes": "CEFR references optional, status starts unassessed"
    },
    {
      "name": "Plans",
      "columns": [
        "plan_id",
        "revision",
        "goal_ids_json",
        "competency_ids_json",
        "rationale",
        "status",
        "created_at_utc"
      ],
      "notes": "version each revision"
    },
    {
      "name": "Activities",
      "columns": [
        "activity_id",
        "lesson_id",
        "session_id",
        "competency_id",
        "activity_type",
        "prompt",
        "rubric_json",
        "status",
        "created_at_utc"
      ],
      "notes": "trusted activity registry for verifying user-submitted IDs"
    },
    {
      "name": "Attempts",
      "columns": [
        "attempt_id",
        "occurred_at_utc",
        "session_id",
        "lesson_id",
        "activity_id",
        "competency_id",
        "activity_type",
        "answer_or_summary",
        "attempt_number",
        "hint_level",
        "assessment",
        "rubric_rationale",
        "review_action",
        "context_id",
        "privacy_mode",
        "observed_modality",
        "observed_operation"
      ],
      "notes": "append-only assessed evidence; modality and operation come from trusted task metadata, not user JSON"
    },
    {
      "name": "Reviews",
      "columns": [
        "review_id",
        "competency_id",
        "content_or_pattern",
        "due_at_utc",
        "success_count",
        "last_outcome",
        "status"
      ],
      "notes": "small, evidence-linked review set"
    },
    {
      "name": "Sessions",
      "columns": [
        "session_id",
        "started_at_utc",
        "ended_at_utc",
        "goal_ids_json",
        "attempt_ids_json",
        "summary",
        "next_step"
      ],
      "notes": "compact summary and honest missing timestamps"
    },
    {
      "name": "Events",
      "columns": [
        "event_id",
        "event_type",
        "entity_id",
        "revision",
        "timestamp_utc",
        "metadata_json"
      ],
      "notes": "auditable migrations/plan corrections; exclude unnecessary raw learner data"
    }
  ]
}
